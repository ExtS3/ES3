# ES3 전체 스택 설정 템플릿 — 이 파일을 같은 위치에 .env로 복사해 사용한다 (copy .env.example .env)
# docker compose는 루트의 .env만 읽는다. 하위 폴더의 .env.example은 Docker 없이 로컬 직접 실행할 때의 템플릿.

# ─────────────────────────────────────────────────────────────
# ExtS3 환경 변수
# 모든 값에 docker-compose.yml 기본값이 있으므로,
# "그대로 복사만 해도" docker compose up이 동작합니다.
# ─────────────────────────────────────────────────────────────

# 웹 접속 포트 (유일하게 외부에 공개되는 포트)
APP_PORT=8000

# ── PostgreSQL (내장 컨테이너, 내부 전용) ──
DB_HOST=db
DB_PORT=5432
DB_USER=example_db_user
DB_PASSWORD=example_db_password
DB_NAME=example_db_name

# ── Nexus (내장 컨테이너 기준) ──
# 내장 Nexus는 randompassword=false 설정이라 항상 admin/admin123으로 시작합니다.
# 외부(사내) Nexus에 연결할 때만 이 값들을 실제 서버에 맞게 바꾸세요.
#   (docker-compose.external-nexus.yml 참고)
NEXUS_BASE_URL=http://nexus:8081
NEXUS_PUBLISHED_PORT=8081
NEXUS_REPOSITORY=extension-demo
NEXUS_USERNAME=admin
NEXUS_PASSWORD=admin123
NEXUS_STORAGE_LIMIT_BYTES=

# ── suppressor (내부 전용) ──
SUPPRESSOR_PRIVATE_IP=suppressor
SUPPRESSOR_PORT=8001
EXTERNAL_RUNNER_MODE=file

# ── suppressor 벡터 DB (내부 전용) ──
PGVECTOR_DB_HOST=vector-db
PGVECTOR_DB_PORT=5432
PGVECTOR_DB_USER=vector_db_user
PGVECTOR_DB_PASSWORD=vector_db_password
PGVECTOR_DB_NAME=vector_db
PGVECTOR_TABLE=public.es3_vector
EMBEDDING_DIM=1024
PGVECTOR_MATCH_THRESHOLD=0
PGVECTOR_MATCH_COUNT=10

# ── 임베딩 (내장 ollama 컨테이너) ──
# 최초 1회 모델 다운로드 필요: docker compose exec ollama ollama pull bge-m3
EMBEDDING_MODEL=bge-m3

# ── AI 판단 모듈 (ai_judgment) ──
ENABLE_AI_JUDGMENT=true
LOCAL_LLM_URL=http://ollama:11434/api/chat
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
AI_JUDGMENT_MAX_TOKENS=1024
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.1
SLACK_WEBHOOK_URL=
DASHBOARD_BASE_URL=http://localhost:8000
OLLAMA_KEEP_ALIVE=5m

# ── suppressor 알림·Nexus (docker compose가 suppressor 컨테이너로 전달) ──
ENABLE_SLACK_FORWARD=true
NEXUS_VERIFY_SSL=false
# 확장 홀딩 시간(초) — 테스트: 30 / 실서비스: 604800 (7일)
HOLDING_SECONDS=30

# ── suppressor 동적 분석 LLM 튜닝 ──
LLM_CONTEXT=4096
LLM_MAX_TOKENS=256
DYNAMIC_MOCK_AUTOSTART=true

# ── suppressor retro 재점검 모니터 · 로깅 ──
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
USER_AGENT=retro-monitor/1.0
RETRO_INTERVAL_HOURS=24
RETRO_QUEUE_PATH=./retro_queue.jsonl
RETRO_STATE_PATH=./retro_state.json
YARA_RULE_PATH=
